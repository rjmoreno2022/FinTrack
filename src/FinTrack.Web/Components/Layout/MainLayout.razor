@inherits LayoutComponentBase
@implements IDisposable
@inject AppState AppState
@inject IDialogService DialogService
@inject IServiceScopeFactory ScopeFactory
@inject ISnackbar Snackbar
@inject IAuthService AuthService
@inject NavigationManager Navigation

<MudThemeProvider Theme="_theme" @bind-IsDarkMode="_isDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1" Color="Color.Surface" Fixed="true">
        <MudIconButton Icon="@Icons.Material.Filled.Menu"
                       Color="Color.Inherit"
                       Edge="Edge.Start"
                       OnClick="@((e) => DrawerToggle())" />
        <MudText Typo="Typo.h6" Class="ml-3 font-weight-bold" Color="Color.Primary">
            💰 FinTrack
        </MudText>

        <MudSpacer />

        <!-- Chip de Tasa de Cambio Activa -->
        <MudChip T="string"
                 Variant="Variant.Filled"
                 Color="Color.Info"
                 Size="Size.Small"
                 Icon="@Icons.Material.Filled.CurrencyExchange"
                 OnClick="OpenExchangeRateDialog"
                 Class="mr-2 cursor-pointer">
            USD: Bs. @AppState.ExchangeRateUsdToVes.ToString("N2") | EUR: Bs. @AppState.ExchangeRateEurToVes.ToString("N2")
        </MudChip>

        <!-- Toggle Moneda Global de Visualización -->
        <MudButtonGroup Color="Color.Primary" Variant="Variant.Outlined" Size="Size.Small" Class="mr-3">
            <MudButton Variant="@(AppState.DisplayCurrency == "USD" ? Variant.Filled : Variant.Outlined)"
                       OnClick='() => AppState.SetDisplayCurrency("USD")'>
                USD $
            </MudButton>
            <MudButton Variant="@(AppState.DisplayCurrency == "EUR" ? Variant.Filled : Variant.Outlined)"
                       OnClick='() => AppState.SetDisplayCurrency("EUR")'>
                EUR €
            </MudButton>
            <MudButton Variant="@(AppState.DisplayCurrency == "VES" ? Variant.Filled : Variant.Outlined)"
                       OnClick='() => AppState.SetDisplayCurrency("VES")'>
                VES Bs.
            </MudButton>
        </MudButtonGroup>

        <MudIconButton Icon="@(_isDarkMode ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)"
                       Color="Color.Inherit"
                       OnClick="@ToggleTheme" />

        <AuthorizeView Context="authContext">
            <Authorized>
                <MudMenu AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight" Dense="true">
                    <ActivatorContent>
                        <MudButton Variant="Variant.Text" Color="Color.Inherit" Class="d-flex align-center gap-2 pa-1 ml-2">
                            <MudAvatar Color="Color.Primary" Size="Size.Small">
                                @(GetInitials(authContext.User))
                            </MudAvatar>
                            <MudText Typo="Typo.body2" Class="font-weight-bold d-none d-md-flex">@authContext.User.Identity?.Name</MudText>
                            <MudIcon Icon="@Icons.Material.Filled.ArrowDropDown" Size="Size.Small" />
                        </MudButton>
                    </ActivatorContent>
                    <ChildContent>
                        <div class="px-4 py-2">
                            <MudText Typo="Typo.subtitle2" Class="font-weight-bold">@authContext.User.Identity?.Name</MudText>
                        </div>
                        <MudDivider />
                        <MudMenuItem Icon="@Icons.Material.Filled.Logout" IconColor="Color.Error" OnClick="HandleLogout">
                            Cerrar sesión
                        </MudMenuItem>
                    </ChildContent>
                </MudMenu>

                <MudTooltip Text="Cerrar sesión">
                    <MudIconButton Icon="@Icons.Material.Filled.Logout"
                                   Color="Color.Error"
                                   Size="Size.Medium"
                                   OnClick="@HandleLogout"
                                   Class="ml-1" />
                </MudTooltip>
            </Authorized>
            <NotAuthorized>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/login" Class="ml-2" Size="Size.Small">
                    Iniciar sesión
                </MudButton>
            </NotAuthorized>
        </AuthorizeView>
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen" ClipMode="DrawerClipMode.Always" Elevation="2">
        <NavMenu />
    </MudDrawer>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.Large" Class="pt-6 pb-12">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    Ocurrió un error no esperado.
    <a href="." class="reload">Recargar</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool _drawerOpen = true;
    private bool _isDarkMode = true;

    protected override async Task OnInitializedAsync()
    {
        AppState.OnChange += StateHasChanged;

        if (!AppState.IsRateLoaded)
        {
            try
            {
                using var scope = ScopeFactory.CreateScope();
                var exchangeRateService = scope.ServiceProvider.GetRequiredService<IExchangeRateService>();
                var latestUsd = await exchangeRateService.GetLatestRateAsync("USD", "VES");
                var latestEur = await exchangeRateService.GetLatestRateAsync("EUR", "VES");

                var usdRate = latestUsd != null && latestUsd.Rate > 0 ? latestUsd.Rate : AppState.ExchangeRateUsdToVes;
                var eurRate = latestEur != null && latestEur.Rate > 0 ? latestEur.Rate : AppState.ExchangeRateEurToVes;
                var source = latestUsd?.Source ?? "BCV";

                AppState.SetExchangeRates(usdRate, eurRate, source, latestUsd?.Date);
            }
            catch
            {
                // Si la base de datos está vacía o aún no inicializada, usa la tasa por defecto de AppState
            }
        }
    }

    public void Dispose()
    {
        AppState.OnChange -= StateHasChanged;
    }

    private async Task OpenExchangeRateDialog()
    {
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<Components.Dialogs.ExchangeRateDialog>("Tasa de Cambio", options);
        var result = await dialog.Result;

        if (result != null && !result.Canceled)
        {
            Snackbar.Add("Tasa de cambio actualizada", Severity.Success);
        }
    }

    private void DrawerToggle() => _drawerOpen = !_drawerOpen;
    private void ToggleTheme() => _isDarkMode = !_isDarkMode;

    private async Task HandleLogout()
    {
        await AuthService.LogoutAsync();
        Navigation.NavigateTo("/login", true);
    }

    private static string GetInitials(System.Security.Claims.ClaimsPrincipal user)
    {
        var name = user.Identity?.Name;
        if (string.IsNullOrWhiteSpace(name))
            return "U";

        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length >= 2)
            return $"{parts[0][0]}{parts[1][0]}".ToUpper();
        return name[..Math.Min(2, name.Length)].ToUpper();
    }

    private readonly MudTheme _theme = new()
    {
        PaletteLight = new PaletteLight()
        {
            Primary = "#238636",
            Secondary = "#0969da",
            AppbarBackground = "#ffffff",
            AppbarText = "#24292f",
            Background = "#f6f8fa",
            Surface = "#ffffff",
            TextPrimary = "#24292f",
            TextSecondary = "#57606a",
            ActionDefault = "#57606a",
            DrawerBackground = "#ffffff",
            DrawerText = "#24292f",
            DrawerIcon = "#57606a",
            Success = "#2da44e",
            Error = "#cf222e",
            Warning = "#bf8700",
            Info = "#0969da"
        },
        PaletteDark = new PaletteDark()
        {
            Primary = "#2ea043",
            Secondary = "#58a6ff",
            AppbarBackground = "#161b22",
            AppbarText = "#c9d1d9",
            Background = "#0d1117",
            Surface = "#161b22",
            TextPrimary = "#c9d1d9",
            TextSecondary = "#8b949e",
            ActionDefault = "#8b949e",
            DrawerBackground = "#161b22",
            DrawerText = "#c9d1d9",
            DrawerIcon = "#8b949e",
            Success = "#3fb950",
            Error = "#f85149",
            Warning = "#d29922",
            Info = "#58a6ff"
        }
    };
}
